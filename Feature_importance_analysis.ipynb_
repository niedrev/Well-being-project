THESE PLACEHOLDER NAMES WITH THE ACTUAL COLUMN NAMES FOUND IN THE PRINTED LIST**\n","q15_col_name = 'Vēlme_ieteikt_kompāniju_Binary' # Replace with actual Q15 binary column name\n","q16_col_name = 'Ieteikumi_Binary' # Replace with actual Q16 binary column name\n","q17_col_name = 'Vēlme_darīt_Binary' # Replace with actual Q17 binary column name\n","\n","# --- Validation checks for existence of Q15, Q16, Q17 columns in X ---\n","required_engagement_cols = [q15_col_name, q16_col_name, q17_col_name]\n","missing_cols = [col for col in required_engagement_cols if col not in X.columns]\n","\n","if missing_cols:\n","    # If the exact binary column names are not found, try to locate them\n","    # This part is similar to the original code's attempt to find Q15,\n","    # but needs to be adapted for Q16 and Q17 as well.\n","    print(f\"Required engagement columns not found directly: {missing_cols}\")\n","    print(\"Attempting to find potential columns based on names...\")\n","\n","    found_cols = {}\n","    for req_col in missing_cols:\n","        # Example: look for columns starting with the base name before '_Binary'\n","        base_name = req_col.replace('_Binary', '')\n","        potential_cols = [col for col in X.columns if col.startswith(base_name)]\n","        if potential_cols:\n","            print(f\"Found potential columns for '{req_col}': {potential_cols}\")\n","            # You need to manually verify which of these is the correct binary column (0 or 1)\n","            # For demonstration, we'll assume the first found potential column is correct,\n","            # but this is a critical step to get right with your actual data.\n","            selected_col = potential_cols[0] # VERIFY THIS IS THE CORRECT BINARY COLUMN\n","            print(f\"Using '{selected_col}' for '{req_col}'.\")\n","            found_cols[req_col] = selected_col\n","        else:\n","             raise ValueError(f\"Engagement component column '{req_col}' not found in X, and no potential columns found.\")\n","\n","    # Update the column names to the found ones\n","    q15_col_name = found_cols.get(q15_col_name, q15_col_name)\n","    q16_col_name = found_cols.get(q16_col_name, q16_col_name)\n","    q17_col_name = found_cols.get(q17_col_name, q17_col_name)\n","\n","# After validation, the column names should be correct or an error was raised.\n","# Proceed assuming q15_col_name, q16_col_name, q17_col_name hold the correct binary column names.\n","\n","\n","# Combine X and y for easier calculation, aligning by index\n","# Ensure X and y have the same index\n","if not X.index.equals(y.index):\n","    # If indices don't match, you need to find a way to align them,\n","    # perhaps using an Employee ID column if available and common to both.\n","    # For now, assuming they are aligned.\n","    print(\"Warning: X and y indices do not match. Proceeding, but results may be incorrect if data is not aligned.\")\n","\n","data = pd.concat([X, y], axis=1)\n","\n","# Ensure wellbeing column is numeric\n","data[wellbeing_col_name] = pd.to_numeric(data[wellbeing_col_name], errors='coerce')\n","\n","# Calculate the combined Engagement Score\n","# Ensure the engagement component columns are treated as integer 0/1 before summing\n","data[q15_col_name] = data[q15_col_name].astype(int)\n","data[q16_col_name] = data[q16_col_name].astype(int)\n","data[q17_col_name] = data[q17_col_name].astype(int)\n","\n","data['Combined_Engagement_Score'] = data[q15_col_name] + data[q16_col_name] + data[q17_col_name]\n","\n","# Drop rows where Well-being or the required Engagement components are missing\n","data.dropna(subset=[wellbeing_col_name, q15_col_name, q16_col_name, q17_col_name], inplace=True)\n","\n","\n","# Calculate average well-being score for the entire dataset\n","overall_average_wellbeing = data[wellbeing_col_name].mean()\n","\n","# Calculate the overall average of the combined Engagement Score\n","overall_average_engagement_score = data['Combined_Engagement_Score'].mean()\n","\n","# Calculate the Well-being-to-Engagement Ratio (WER) using overall averages\n","if overall_average_engagement_score > 0:\n","    wer_ratio = overall_average_wellbeing / overall_average_engagement_score\n","else:\n","    wer_ratio = np.nan # Avoid division by zero if average engagement is zero\n","\n","print(f\"Overall Average Well-being Score: {overall_average_wellbeing:.2f}\")\n","print(f\"Overall Average Combined Engagement Score: {overall_average_engagement_score:.2f}\")\n","print(f\"Well-being-to-Engagement (WER) Ratio: {wer_ratio:.2f}\")\n","\n","# Optional: Print average well-being for each level of the combined engagement score\n","print(\"\\nAverage Well-being Score by Combined Engagement Score Level:\")\n","print(data.groupby('Combined_Engagement_Score')[wellbeing_col_name].mean().round(2))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"gWvSI960xZg3","executionInfo":{"status":"ok","timestamp":1748322537261,"user_tz":-180,"elapsed":99,"user":{"displayName":"Vija Niedre","userId":"16452881736730193225"}},"outputId":"b790c805-cf81-4723-e5d7-2dcb2f4d4b03"},"execution_count":62,"outputs":[{"output_type":"stream","name":"stdout","text":["Columns in X DataFrame:\n","['Apmācības_vajadzības_Cits', \"Apmācības_vajadzības_Cits: Varētu ik pa laikam ka'dus kursus apmeklēt\", 'Apmācības_vajadzības_Jā, vēlos apgūt jaunas prasmes un pienākumus', 'Apmācības_vajadzības_Jā, vēlos apgūt labāk esošo darbu', 'Apmācības_vajadzības_Nē', 'Apmierinātība_ar_darba_laiku_Cits', 'Apmierinātība_ar_darba_laiku_Cits: Vairāk vai mazāk, kad ir viens objekts, tad ir normāli, pieliekot vairākus objektus paslīd garām stulbas lietas un tas laiks ārpus darba īsti nav atpūta.', 'Apmierinātība_ar_darba_laiku_Jā', 'Apmierinātība_ar_darba_laiku_Nē, jo atpūta par īsu', 'Apmierinātība_ar_darba_laiku_Nē, jo pārāk garas darba stundas', 'Apmierinātība_ar_darba_slodzi_Cits', 'Apmierinātība_ar_darba_slodzi_Cits: Daļēji', 'Apmierinātība_ar_darba_slodzi_Cits: Dažubrīd ir pa