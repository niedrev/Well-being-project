                      7   \n","top     Ar laiku paliek skaidrāk, jo uzņēmies vairāk a...   \n","freq                                                    1   \n","\n","                             Novērtējums_Komentāri  \\\n","count                                            4   \n","unique                                           4   \n","top     Minētie novērtējumi ir par to, ko vēlētos.   \n","freq                                             1   \n","\n","        Priekšlikumi_tiešajam_vadītājam_Komentāri Saziņa_Komentāri  \\\n","count                                           3                5   \n","unique                                          3                5   \n","top     Uzklausa, dažreiz ņem vērā, ar ko pietiek          Epasts.   \n","freq                                            1                1   \n","\n","                                         Stress_Komentāri  \\\n","count                                                   8   \n","unique                                                  8   \n","top     Darbu apjoms - pēc klusākām dienām nāk pārpild...   \n","freq                                                    1   \n","\n","                      Tiešā_vadītāja_kompetence_Komentāri Vēlme_darīt  \\\n","count                                                   5          54   \n","unique                                                  5          50   \n","top     Dažreiz liekas ke ne, bet tas laikam man dēļ p...           -   \n","freq                                                    1           3   \n","\n","       Vēlme_ieteikt_kompāniju_Komentāri  \\\n","count                                  6   \n","unique                                 6   \n","top                             Jā un Nē   \n","freq                                   1   \n","\n","       Vispārējās_labsajūtas_rādītājs_Komentāri  \n","count                                         4  \n","unique                                        4  \n","top                    Nevar ieklikšķināt bet 9  \n","freq                                          1  \n"]}]},{"cell_type":"markdown","source":["##Analysis"],"metadata":{"id":"VIOOKvJnWxWK"}},{"cell_type":"markdown","source":["###Business Requirements Understanding"],"metadata":{"id":"S4anIOe4Ylt9"}},{"cell_type":"markdown","source":["Hypothetical Business Problem: **\"Identifying factors that contribute to employee dissatisfaction and predicting areas of improvement to enhance workplace wellbeing.\"**\n","\n"],"metadata":{"id":"ejxSeXnAX_Va"}},{"cell_type":"markdown","source":["###Data Extraction Techniques"],"metadata":{"id":"f9YAwYqyYxKw"}},{"cell_type":"markdown","source":["To identify the most important features in project dataset author plans to make following steps:\n","\n","\n","1.  Understand the Dataset: Analyze data types (numerical, categorical, textual) and features like employee department, ratings, and feedback."],"metadata":{"id":"nDPgddYrYJFV"}},{"cell_type":"code","source":["# Histogram for numeric data\n","structured_data['Respondent_ID'].hist()\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":430},"id":"5fhWi5SlGvNR","executionInfo":{"status":"ok","timestamp":1748305586341,"user_tz":-180,"elapsed":197,"user":{"displayName":"Vija Niedre","userId":"16452881736730193225"}},"outputId":"f9bc39d6-f74e-40b9-a89b-7bf851374238"},"execution_count":14,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 640x480 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["# Exploring respondents by departments for each company\n","\n","# Group data by department, then count respondents\n","respondent_counts_by_department = structured_data.groupby([ 'Nodaļa_Anonymized'])['Respondent_ID'].nunique()\n","# Display the results\n","print(respondent_counts_by_department)\n","\n","respondent_counts_by_department.plot(kind='bar', figsize=(10, 6))\n","plt.title('Respondents per Department by Company')\n","plt.xlabel('Company Name')\n","plt.ylabel('Number of Respondents')\n","plt.xticks(rotation=45, ha='right')\n","plt.legend(title='Department')\n","plt.tight_layout()\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":781},"id":"sTSfjr7NWuqP","executionInfo":{"status":"ok","timestamp":1748305586584,"user_tz":-180,"elapsed":249,"user":{"displayName":"Vija Niedre","userId":"16452881736730193225"}},"outputId":"65bb7be6-ac0f-4362-97cd-dd7aec4494c6"},"execution_count":15,"outputs":[{"output_type":"stream","name":"stdout","text":["Nodaļa_Anonymized\n","Izvēlos nenorādīt     2\n","Nodaļa_1              7\n","Nodaļa_2              7\n","Nodaļa_3             21\n","Nodaļa_4              9\n","Nodaļa_5              2\n","Nodaļa_6              2\n","Nodaļa_7              4\n","Name: Respondent_ID, dtype: int64\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1000x600 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"markdown","source":["2.  Feature Selection\n","    *   Use statistical methods (e.g., correlation analysis, ANOVA)."],"metadata":{"id":"2u_63Gd5mPOi"}},{"cell_type":"code","source":["# Example: ANOVA (Analysis of Variance) for structured_data\n","# Check if there's a significant difference in Wellbeing Score between departments\n","import statsmodels.formula.api as sm\n","import matplotlib.pyplot as plt\n","import seaborn as sns\n","\n","# Ensure 'normalized_wellbeing_scores' and 'Nodaļa_Anonymized' columns exist\n","# and 'normalized_wellbeing_scores' is numeric.\n","# If not, you would need to create them first based on your data loading and processing steps.\n","# Assuming 'normalized_wellbeing_scores' has already been calculated and added to structured_data.\n","\n","# Perform ANOVA using the formula API\n","# 'normalized_wellbeing_scores' is the dependent variable\n","# 'C(Nodaļa_Anonymized)' treats 'Nodaļa_Anonymized' as a categorical independent variable\n","model = sm.ols('normalized_wellbeing_scores ~ C(Nodaļa_Anonymized)', data=structured_data).fit()\n","\n","# Print the ANOVA summary\n","print(model.summary())\n","\n","# Post-hoc analysis (Tukey's HSD) to identify which groups differ significantly\n","from statsmodels.stats.multicomp import pairwise_tukeyhsd\n","\n","# Ensure there are enough groups and non-null values for the test\n","if len(structured_data['Nodaļa_Anonymized'].unique()) > 1 and structured_data['normalized_wellbeing_scores'].isnull().sum() < len(structured_data):\n","    # Perform Tukey's HSD test\n","    m_comp = pairwise_tukeyhsd(endog=structured_data['normalized_wellbeing_scores'].dropna(),\n","                               groups=structured_data['Nodaļa_Anonymized'][structured_data['normalized_wellbeing_scores'].notna()],\n","                               alpha=0.05)\n","\n","    # Print the results of the post-hoc test\n","    print(m_comp)\n","else:\n","    print(\"Cannot perform Tukey's HSD test: Either only one department exists or wellbeing scores are all null.\")\n","\n","# Optional: Visualize the distribution of normalized wellbeing scores across departments\n","if 'normalized_wellbeing_scores' in structured_data.columns and 'Nodaļa_Anonymized' in structured_data.columns:\n","    plt.figure(figsize=(12, 6))\n","    sns.boxplot(x='Nodaļa_Anonymized', y='normalized_wellbeing_scores', data=structured_data.dropna(subset=['normalized_wellbeing_scores', 'Nodaļa_Anonymized']))\n","    plt.title('Distribution of Normalized Wellbeing Scores Across Departments')\n","    plt.xlabel('Department')\n","    plt.ylabel('Normalized Wellbeing Score')\n","    plt.xticks(rotation=45, ha='right')\n","    plt.tight_layout()\n","    plt.show()\n","else:\n","    print(\"Cannot create boxplot: Missing 'normalized_wellbeing_scores' or 'Nodaļa_Anonymized' column.\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":443},"id":"AqxeNoeBsira","executionInfo":{"status":"error","timestamp":1748305604525,"user_tz":-180,"elapsed":60,"user":{"displa